export const brand = {
  name: '{{ meta.productName }}',
  primary: '{{ designLanguage.colors.primary }}',
  accent: '{{ designLanguage.colors.accent }}',
};

export const designAppTheme = {
  colorPrimary: '{{ designLanguage.colors.primary }}',
  colorInfo: '{{ designLanguage.colors.primary }}',
  colorSuccess: '{{ designLanguage.colors.success }}',
  colorWarning: '{{ designLanguage.colors.warning }}',
  colorError: '{{ designLanguage.colors.danger }}',
  colorText: '{{ designLanguage.colors.neutral.text }}',
  colorTextSecondary: '{{ designLanguage.colors.neutral.textSecondary }}',
  colorBorder: '{{ designLanguage.colors.neutral.border }}',
  colorBgBase: '{{ designLanguage.colors.neutral.bg }}',
  borderColor: '{{ designLanguage.colors.neutral.border }}',
  borderRadius: {{ designLanguage.radius.md }},
  fontSize: {{ designLanguage.typography.body.size }},
  fontFamily: '{{ designLanguage.typography.fontFamily }}',
  wireframe: false,
};

export function applyDesignTheme() {
  const root = document.documentElement.style;
  root.setProperty('--ux-primary', '{{ designLanguage.colors.primary }}');
  root.setProperty('--ux-primary-dark', '{{ designLanguage.colors.primaryDark }}');
  root.setProperty('--ux-accent', '{{ designLanguage.colors.accent }}');
  root.setProperty('--ux-success', '{{ designLanguage.colors.success }}');
  root.setProperty('--ux-warning', '{{ designLanguage.colors.warning }}');
  root.setProperty('--ux-danger', '{{ designLanguage.colors.danger }}');
  root.setProperty('--ux-info', '{{ designLanguage.colors.info }}');
  root.setProperty('--ux-text', '{{ designLanguage.colors.neutral.text }}');
  root.setProperty('--ux-text-secondary', '{{ designLanguage.colors.neutral.textSecondary }}');
  root.setProperty('--ux-border', '{{ designLanguage.colors.neutral.border }}');
  root.setProperty('--ux-bg', '{{ designLanguage.colors.neutral.bg }}');
  root.setProperty('--ux-bg-alt', '{{ designLanguage.colors.neutral.bgAlt }}');
  root.setProperty('--ux-radius-sm', '{{ designLanguage.radius.sm }}px');
  root.setProperty('--ux-radius-md', '{{ designLanguage.radius.md }}px');
  root.setProperty('--ux-radius-lg', '{{ designLanguage.radius.lg }}px');
  root.setProperty('--ux-shadow-card', '{{ designLanguage.shadow.card }}');
  root.setProperty('--ux-font-family', '{{ designLanguage.typography.fontFamily }}');
}
