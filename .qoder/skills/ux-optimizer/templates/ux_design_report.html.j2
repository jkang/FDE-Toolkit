<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ company }}-{{ scenario }}-UX设计报告</title>
<style>
  :root {
    --p: {{ designLanguage.colors.primary }};
    --p-dark: {{ designLanguage.colors.primaryDark }};
    --accent: {{ designLanguage.colors.accent }};
    --success: {{ designLanguage.colors.success }};
    --warning: {{ designLanguage.colors.warning }};
    --danger: {{ designLanguage.colors.danger }};
    --text: {{ designLanguage.colors.neutral.text }};
    --text2: {{ designLanguage.colors.neutral.textSecondary }};
    --border: {{ designLanguage.colors.neutral.border }};
    --bg: {{ designLanguage.colors.neutral.bg }};
    --bg-alt: {{ designLanguage.colors.neutral.bgAlt }};
    --radius: {{ designLanguage.radius.md }}px;
    --shadow: {{ designLanguage.shadow.card }};
    --font: {{ designLanguage.typography.fontFamily }};
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: var(--font); background: var(--bg-alt); color: var(--text); line-height: 1.5; }
  .container { max-width: 1400px; margin: 0 auto; padding: 32px 24px; }
  .header { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 28px 32px; position: relative; overflow: hidden; }
  .header::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: var(--accent); }
  .header h1 { margin: 0 0 8px 12px; font-size: 28px; }
  .header .sub { color: var(--text2); margin-left: 12px; }
  .badges { display: flex; gap: 10px; margin: 16px 0 0 12px; flex-wrap: wrap; }
  .badge { font-size: 12px; padding: 4px 12px; border-radius: 999px; background: var(--bg-alt); color: var(--text2); border: 1px solid var(--border); }
  .badge.dom { background: var(--p); color: #fff; border: none; }
  .badge.mode { background: var(--accent); color: #fff; border: none; }
  h2.sec { margin: 32px 0 16px; font-size: 22px; display: flex; align-items: center; gap: 10px; }
  h2.sec::before { content: ""; width: 4px; height: 22px; background: var(--accent); border-radius: 2px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .card { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px; }
  .card h3 { margin: 0 0 12px; font-size: 15px; color: var(--p-dark); }
  .spec-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px dashed var(--border); font-size: 14px; }
  .spec-item:last-child { border-bottom: none; }
  .spec-item .k { color: var(--text2); }
  .spec-item .v { font-weight: 600; }
  .swatch { display: flex; align-items: center; gap: 10px; padding: 8px 0; }
  .swatch .dot { width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--border); flex-shrink: 0; }
  .radar-wrap { display: grid; grid-template-columns: 280px 1fr; gap: 24px; align-items: center; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); padding: 24px; }
  .radar-legend { display: flex; flex-direction: column; gap: 12px; }
  .radar-legend .row { display: flex; align-items: center; gap: 8px; }
  .radar-legend .bar { flex: 1; height: 10px; background: var(--bg-alt); border-radius: 5px; overflow: hidden; }
  .radar-legend .fill { height: 100%; background: var(--p); border-radius: 5px; }
  table.cmp { width: 100%; border-collapse: collapse; background: var(--bg); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
  table.cmp th, table.cmp td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--border); font-size: 14px; }
  table.cmp th { background: var(--bg-alt); font-weight: 600; }
  table.cmp tr:last-child td { border-bottom: none; }
  .pill { font-size: 12px; padding: 2px 10px; border-radius: 999px; }
  .pill.old { background: #f1f5f9; color: var(--text2); }
  .pill.new { background: rgba(37,99,235,.12); color: var(--p); font-weight: 600; }
  .footer { text-align: center; color: var(--text2); font-size: 12px; margin: 40px 0 20px; }
  .btn-actions { display: flex; gap: 12px; }
  .btn { font-size: 13px; padding: 8px 16px; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); color: var(--text); cursor: pointer; transition: all .15s ease-out; }
  .btn:hover { box-shadow: var(--shadow); }
  .btn.primary { background: var(--p); color: #fff; border: none; }
</style>
</head>
<body>
<div class="container">

  <div class="header">
    <div style="position:absolute;right:24px;top:24px;" class="btn-actions">
      <button class="btn" onclick="window.print()">导出 PDF / 打印</button>
      <button class="btn primary" onclick="copyYaml()">复制原始 YAML</button>
    </div>
    <h1>{{ company }} · {{ scenario }}</h1>
    <div class="sub">UX 定制设计系统 · UX-Optimizer</div>
    <div class="badges">
      <span class="badge dom">业务域：{{ meta.businessDomain }}</span>
      <span class="badge mode">产品 UI 模式：{{ meta.mode }}</span>
      <span class="badge">品牌来源：{{ meta.brandSource }}</span>
      <span class="badge">主色：{{ designLanguage.colors.primary }}</span>
    </div>
  </div>

  <h2 class="sec">企业品牌画像（人格）</h2>
  <div class="grid">
    <div class="card">
      <h3>品牌基调</h3>
      <div class="spec-item"><span class="k">主色调性</span><span class="v">{{ brandProfile.primaryTone }}</span></div>
      <div class="spec-item"><span class="k">主色</span><span class="v">{{ brandProfile.primaryColor }}</span></div>
    </div>
    <div class="card">
      <h3>用户与场景</h3>
      <div class="spec-item"><span class="k">用户群体</span><span class="v">{{ brandProfile.userGroup }}</span></div>
      <div class="spec-item"><span class="k">场景严肃度</span><span class="v">{{ brandProfile.seriousness }}</span></div>
      <div class="spec-item"><span class="k">品牌成熟度</span><span class="v">{{ brandProfile.maturity }}</span></div>
    </div>
  </div>

  <h2 class="sec">定制设计语言（8 维）</h2>
  <div class="grid">
    <div class="card">
      <h3>① 色彩系统</h3>
      <div class="swatch"><span class="dot" style="background:{{ designLanguage.colors.primary }}"></span><span>主色 {{ designLanguage.colors.primary }}</span></div>
      <div class="swatch"><span class="dot" style="background:{{ designLanguage.colors.accent }}"></span><span>强调 {{ designLanguage.colors.accent }}</span></div>
      <div class="swatch"><span class="dot" style="background:{{ designLanguage.colors.success }}"></span><span>成功 {{ designLanguage.colors.success }}</span></div>
      <div class="swatch"><span class="dot" style="background:{{ designLanguage.colors.warning }}"></span><span>警告 {{ designLanguage.colors.warning }}</span></div>
      <div class="swatch"><span class="dot" style="background:{{ designLanguage.colors.danger }}"></span><span>危险 {{ designLanguage.colors.danger }}</span></div>
    </div>
    <div class="card">
      <h3>② 字体系统</h3>
      <div class="spec-item"><span class="k">字体</span><span class="v">{{ designLanguage.typography.fontFamily }}</span></div>
      <div class="spec-item"><span class="k">H1</span><span class="v">{{ designLanguage.typography.h1.size }}px / {{ designLanguage.typography.h1.weight }}</span></div>
      <div class="spec-item"><span class="k">H2</span><span class="v">{{ designLanguage.typography.h2.size }}px / {{ designLanguage.typography.h2.weight }}</span></div>
      <div class="spec-item"><span class="k">正文</span><span class="v">{{ designLanguage.typography.body.size }}px / {{ designLanguage.typography.body.lineHeight }}</span></div>
    </div>
    <div class="card">
      <h3>③ 间距 & 栅格</h3>
      <div class="spec-item"><span class="k">8pt scale</span><span class="v">{{ designLanguage.spacing.scale | join(' / ') }}</span></div>
      <div class="spec-item"><span class="k">内容最大宽</span><span class="v">{{ designLanguage.spacing.contentMaxWidth }}px</span></div>
      <div class="spec-item"><span class="k">卡片内距</span><span class="v">{{ designLanguage.spacing.cardPadding }}px</span></div>
    </div>
    <div class="card">
      <h3>④ 圆角 / 阴影</h3>
      <div class="spec-item"><span class="k">圆角 sm/md/lg</span><span class="v">{{ designLanguage.radius.sm }}/{{ designLanguage.radius.md }}/{{ designLanguage.radius.lg }}</span></div>
      <div class="spec-item"><span class="k">卡片阴影</span><span class="v" style="font-size:11px">{{ designLanguage.shadow.card }}</span></div>
    </div>
    <div class="card">
      <h3>⑥ 状态体系</h3>
      <div class="spec-item"><span class="k">过渡</span><span class="v">{{ designLanguage.states.hoverTime }}</span></div>
      <div class="spec-item"><span class="k">焦点轮廓</span><span class="v">{{ designLanguage.states.focusOutline }}</span></div>
      <div class="spec-item"><span class="k">Loading</span><span class="v">{{ designLanguage.states.loadingType }}</span></div>
    </div>
    <div class="card">
      <h3>⑧ 微交互 & 响应式</h3>
      <div class="spec-item"><span class="k">过渡</span><span class="v">{{ designLanguage.motion.transition }}</span></div>
      <div class="spec-item"><span class="k">断点</span><span class="v">{{ designLanguage.responsive.breakpoints | join(' / ') }}</span></div>
    </div>
  </div>

  <h2 class="sec">六维 UX 专业评分（figma_expertise）</h2>
  <div class="radar-wrap">
    <div class="radar-legend">
      {% for dim in ux_scores %}
      <div class="row">
        <span style="width:130px;font-weight:600;font-size:13px">{{ dim.name }}</span>
        <div class="bar"><div class="fill" style="width:{{ dim.score * 10 }}%"></div></div>
        <span style="width:32px;text-align:right;font-size:13px">{{ dim.score }}</span>
      </div>
      {% endfor %}
    </div>
    <div style="text-align:center;">
      <div style="font-size:42px;font-weight:700;color:var(--p)">{{ avg_score }}</div>
      <div style="color:var(--text2);font-size:13px">综合 UX 评级（满分 10）</div>
    </div>
  </div>

  <h2 class="sec">组件专业化（componentSpecs）</h2>
  <table class="cmp">
    <tr><th>元素</th><th>升级方向</th></tr>
    {% for cs in componentSpecs %}
    <tr><td style="font-weight:600">{{ cs.element }}</td><td>{{ cs.v2.style }}</td></tr>
    {% endfor %}
  </table>

  <h2 class="sec">Before / After 对照</h2>
  <table class="cmp">
    <tr><th>维度</th><th>优化前（默认 antd/arco）</th><th>优化后（定制设计系统）</th></tr>
    {% for d in diff_before_after %}
    <tr>
      <td style="font-weight:600">{{ d.dimension }}</td>
      <td><span class="pill old">{{ d.before }}</span></td>
      <td><span class="pill new">{{ d.after }}</span></td>
    </tr>
    {% endfor %}
  </table>

  <h2 class="sec">交付核对（ux_checklist）</h2>
  <div class="card" style="font-size:14px;">
    <ul style="margin:0;padding-left:18px;line-height:2;">
      {% for diff in designLanguage.diffChecklist %}<li>{{ diff }}</li>{% endfor %}
    </ul>
  </div>

  <div class="footer">UX-Optimizer · {{ company }}-{{ scenario }} · 定制设计系统报告（产品级 MVP，与 design.md 解耦）</div>
</div>

<script id="raw-yaml" type="application/yaml">
__RAW_YAML__
</script>
<script>
function copyYaml() {
  const el = document.getElementById('raw-yaml');
  const text = el.textContent.trim();
  navigator.clipboard.writeText(text).then(() => alert('已复制 YAML 到剪贴板'));
}
</script>
</body>
</html>
