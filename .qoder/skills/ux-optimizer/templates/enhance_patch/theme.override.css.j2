/* =========================================================
   UX-Optimizer · 定制设计系统覆盖层 (theme.override)
   由 apply_ux_enhance.py 从 ux-audit.yaml 生成
   无侵入：仅覆盖视觉，不改业务逻辑与接口
   ========================================================= */

:root {
  --ux-primary: {{ designLanguage.colors.primary }};
  --ux-primary-dark: {{ designLanguage.colors.primaryDark }};
  --ux-accent: {{ designLanguage.colors.accent }};
  --ux-success: {{ designLanguage.colors.success }};
  --ux-warning: {{ designLanguage.colors.warning }};
  --ux-danger: {{ designLanguage.colors.danger }};
  --ux-info: {{ designLanguage.colors.info }};
  --ux-text: {{ designLanguage.colors.neutral.text }};
  --ux-text-secondary: {{ designLanguage.colors.neutral.textSecondary }};
  --ux-border: {{ designLanguage.colors.neutral.border }};
  --ux-bg: {{ designLanguage.colors.neutral.bg }};
  --ux-bg-alt: {{ designLanguage.colors.neutral.bgAlt }};
  --ux-gradient-from: {{ designLanguage.colors.gradient.from }};
  --ux-gradient-to: {{ designLanguage.colors.gradient.to }};
  --ux-font-family: {{ designLanguage.typography.fontFamily }};
  --ux-radius-md: {{ designLanguage.radius.md }}px;
  --ux-radius-lg: {{ designLanguage.radius.lg }}px;
  --ux-shadow-card: {{ designLanguage.shadow.card }};
  --ux-transition: {{ designLanguage.motion.transition }};
  --ux-content-max: {{ designLanguage.spacing.contentMaxWidth }}px;
  --ux-card-padding: {{ designLanguage.spacing.cardPadding }}px;
}

/* ---------- 全局字体 & 排版 ---------- */
* {
  font-family: var(--ux-font-family);
}
body {
  color: var(--ux-text);
  background: var(--ux-bg);
}
h1 { font-size: {{ designLanguage.typography.h1.size }}px; font-weight: {{ designLanguage.typography.h1.weight }}; line-height: 1.2; letter-spacing: -0.02em; color: var(--ux-text); }
h2 { font-size: {{ designLanguage.typography.h2.size }}px; font-weight: {{ designLanguage.typography.h2.weight }}; line-height: 1.3; color: var(--ux-text); }
h3 { font-size: {{ designLanguage.typography.h3.size }}px; font-weight: {{ designLanguage.typography.h3.weight }}; line-height: 1.4; color: var(--ux-text); }

/* ---------- 组件视觉（卡片 / 表格） ---------- */
.ant-card, .arco-card {
  border-radius: var(--ux-radius-md);
  box-shadow: var(--ux-shadow-card);
  border: 1px solid var(--ux-border);
}
.ant-table-thead > tr > th, .arco-table-th {
  background: var(--ux-bg-alt) !important;
  font-weight: 600;
}
.ant-table-tbody > tr:hover > td, .arco-table-tr:hover .arco-table-td {
  background: var(--ux-bg-alt) !important;
}

/* ---------- 字体层级（Label 全大写） ---------- */
.ant-typography, .arco-typography { color: var(--ux-text); }
.label-caps {
  font-size: {{ designLanguage.typography.label.size }}px;
  font-weight: {{ designLanguage.typography.label.weight }};
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--ux-text-secondary);
}

/* ---------- 交互状态 ---------- */
* { transition: background var(--ux-transition), border-color var(--ux-transition), box-shadow var(--ux-transition), color var(--ux-transition), transform var(--ux-transition); }
a, .ant-btn, .arco-btn, .ant-card, .arco-card, .ant-menu-item, .arco-menu-item, [role="button"], .clickable { cursor: pointer; }
a:focus-visible, .ant-btn:focus-visible, .arco-btn:focus-visible, .ant-input:focus-visible, .arco-input:focus-visible,
input:focus-visible, .ant-select-selector:focus-visible, .arco-select-view:focus-visible {
  outline: 2px solid {{ designLanguage.states.focusOutline }} !important;
  outline-offset: 1px;
}
.ant-btn-primary, .arco-btn-primary { box-shadow: var(--ux-shadow-card); }
.ant-btn-primary:hover, .arco-btn-primary:hover { opacity: 0.85; }
.ant-card:hover, .arco-card:hover { box-shadow: 0 4px 16px rgba(16,33,62,0.12); }

/* ---------- 品牌 Header（定制） ---------- */
.ux-app-header {
  display: flex; align-items: center; justify-content: space-between;
  height: 56px; padding: 0 24px; background: var(--ux-bg);
  border-bottom: 1px solid var(--ux-border);
  position: sticky; top: 0; z-index: 10;
}
.ux-app-header .ux-title { font-size: 22px; font-weight: 600; color: var(--ux-text); }
.ux-app-header .ux-subtitle { font-size: 13px; color: var(--ux-text-secondary); margin-left: 12px; }

/* ---------- 响应式断点 ---------- */
@media (max-width: 375px) { .ant-card, .arco-card { padding: 16px; } .ux-app-header { padding: 0 16px; } }
@media (max-width: 768px) { .ux-app-header .ux-subtitle { display: none; } }
@media (max-width: 1024px) { .ux-content { max-width: 100%; } }
@media (min-width: 1440px) { .ux-content { max-width: var(--ux-content-max); } }
